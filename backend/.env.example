# Copy to backend/.env and adjust as needed. Defaults run with zero setup (SQLite).

# --- Database ---
# SQLite (default, zero-setup):
DATABASE_URL=sqlite:///./scholarship.db
# PostgreSQL (docker-compose uses this):
# DATABASE_URL=postgresql+psycopg2://scholar:scholar@localhost:5432/scholarship

# --- Auth ---
JWT_SECRET=dev-secret-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=720

# --- PII encryption at rest (Fernet, 32 url-safe base64 bytes) ---
# Dev key only. Generate a real one:  python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=DIFF9uhlgzh2qvkCBEFMx6GpkoznIKgnTaQFDSt7dyk=

# --- Files ---
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=10

# --- AI / OCR ---
# Optional Claude extraction layer (off by default; Tesseract used when available,
# and sample documents ship with a ground-truth sidecar so OCR works offline).
USE_LLM_EXTRACTION=false
ANTHROPIC_API_KEY=

# --- CORS ---
FRONTEND_ORIGIN=http://localhost:3000
